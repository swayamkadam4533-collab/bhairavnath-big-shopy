rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{fileName} {
      allow read: if true;
      // Admin-only upload. Replace placeholder with Firebase Auth UID.
      allow write: if request.auth != null && request.auth.uid == "PASTE_ADMIN_UID_HERE"
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}