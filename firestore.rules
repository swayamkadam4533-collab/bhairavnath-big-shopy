rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: replace this placeholder with your own Firebase Auth UID.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "mhrmLM6UJdbGRF4mkoVfrNK9nHH3";
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Starter version: orders and product requests can be created by visitors.
    // Admin-only reads/updates prevent public access to customer phone numbers.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['customerName','phone','items','status'])
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.status == 'Order Placed';
      allow read, update, delete: if isAdmin();
    }
    match /orderCodes/{codeId} {
      allow create: if request.resource.data.keys().hasAll(['orderId','displayId','phone']);
      allow read, update, delete: if isAdmin();
    }
    match /productRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['productName','customerName','phone']);
      allow read, update, delete: if isAdmin();
    }
  }
}
